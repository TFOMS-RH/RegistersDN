@{
    ViewData["Title"] = "Главная";
}

<div class="text-center" style="padding: 60px 20px;">
    <div style="font-size: 72px; color: var(--accent-red); margin-bottom: 20px;">
        <i class="fas fa-heartbeat"></i>
    </div>
    <h1 class="display-4" style="font-weight: 700; color: var(--text-primary);">Добро пожаловать в RegistrDN</h1>
    <p class="lead" style="color: var(--text-secondary); max-width: 600px; margin: 0 auto;">
        Система управления диспансерным наблюдением
    </p>
    <hr style="max-width: 200px; margin: 30px auto; border-color: var(--border-color);" />
    <p style="color: var(--text-muted);">
        Используйте меню в правом верхнем углу для навигации по разделам
    </p>
    <div style="margin-top: 30px; display: flex; gap: 16px; justify-content: center; flex-wrap: wrap;">
        <a asp-controller="Import" asp-action="Index" class="btn-primary-custom" style="padding: 12px 32px; font-size: 16px;">
            <i class="fas fa-upload"></i> Импорт данных
        </a>
        <a asp-controller="Export" asp-action="Index" class="btn-outline-custom" style="padding: 12px 32px; font-size: 16px;">
            <i class="fas fa-file-alt"></i> Журнал и экспорт
        </a>
    </div>
</div>