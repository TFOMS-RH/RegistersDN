@model IEnumerable<RegistrDN.Models.Entities.DnDocumentEntity>

@{
    ViewData["Title"] = "Журнал и экспорт";
    var periods = ViewBag.Periods as List<string> ?? new List<string>();
    var moList = ViewBag.MoList as List<string> ?? new List<string>();
    var currentPage = ViewBag.CurrentPage ?? 1;
    var totalPages = ViewBag.TotalPages ?? 1;
    var totalCount = ViewBag.TotalCount ?? 0;
    var search = ViewBag.Search as string ?? "";
    var type = ViewBag.Type as string ?? "";
    var hospital = ViewBag.Hospital as string ?? "";
    var period = ViewBag.Period as string ?? "";
    var status = ViewBag.Status as string ?? "";
}

<!-- Заголовок страницы -->
<div class="page-header">
    <div>
        <h1>📋 Журнал и экспорт</h1>
        <span class="subtitle">Управление загруженными файлами: проверка, статусы, выгрузка</span>
    </div>
    <div class="page-actions">
        <button class="btn-primary-custom" onclick="location.reload()">
            <i class="fas fa-sync"></i> Обновить
        </button>
        <button class="btn-success-custom" onclick="checkAllDocuments()">
            <i class="fas fa-check-double"></i> Проверить все
        </button>
    </div>
</div>

<!-- Сообщения -->
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Info"] != null)
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        <i class="fas fa-info-circle"></i> @TempData["Info"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- ========================================== -->
<!-- СТАТИСТИКА ПО СТАТУСАМ                     -->
<!-- ========================================== -->
<div class="stat-grid">
    <div class="stat-card blue">
        <div class="stat-icon"><i class="fas fa-upload"></i></div>
        <div class="stat-label">📥 Загружено</div>
        <div class="stat-value" id="statusUploaded">@ViewBag.UploadedCount</div>
    </div>
    <div class="stat-card yellow">
        <div class="stat-icon"><i class="fas fa-spinner fa-pulse"></i></div>
        <div class="stat-label">⏳ Проверяется</div>
        <div class="stat-value" id="statusChecking">@ViewBag.CheckingCount</div>
    </div>
    <div class="stat-card green">
        <div class="stat-icon"><i class="fas fa-check-circle"></i></div>
        <div class="stat-label">✅ Готово</div>
        <div class="stat-value" id="statusReady">@ViewBag.ReadyCount</div>
    </div>
    <div class="stat-card red">
        <div class="stat-icon"><i class="fas fa-exclamation-circle"></i></div>
        <div class="stat-label">❌ Ошибка</div>
        <div class="stat-value" id="statusError">@ViewBag.ErrorCount</div>
    </div>
</div>

<!-- ========================================== -->
<!-- СТАТИСТИКА ПО ТИПАМ                       -->
<!-- ========================================== -->
<div class="stat-grid" style="grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));">
    <div class="stat-card" style="border-left-color: #3182ce;">
        <div class="stat-label">GST / GSM</div>
        <div class="stat-value" style="font-size:16px;">@ViewBag.GstCount</div>
    </div>
    <div class="stat-card" style="border-left-color: #38a169;">
        <div class="stat-label">GPT / GPM</div>
        <div class="stat-value" style="font-size:16px;">@ViewBag.GptCount</div>
    </div>
    <div class="stat-card" style="border-left-color: #7c3aed;">
        <div class="stat-label">DSPN</div>
        <div class="stat-value" style="font-size:16px;">@ViewBag.DspnCount</div>
    </div>
    <div class="stat-card" style="border-left-color: #db2777;">
        <div class="stat-label">PROF</div>
        <div class="stat-value" style="font-size:16px;">@ViewBag.ProfCount</div>
    </div>
    <div class="stat-card" style="border-left-color: #d69e2e;">
        <div class="stat-label">GF</div>
        <div class="stat-value" style="font-size:16px;">@ViewBag.GfCount</div>
    </div>
    <div class="stat-card" style="border-left-color: #f59e0b;">
        <div class="stat-label">DF</div>
        <div class="stat-value" style="font-size:16px;">@ViewBag.DfCount</div>
    </div>
</div>

<!-- ========================================== -->
<!-- БЛОК АГРЕГАЦИИ (ТОЛЬКО ДЛЯ ADMIN)        -->
<!-- ========================================== -->
@if (User.IsInRole("Admin"))
{
    <div class="aggregation-box">
        <div class="info">
            <i class="fas fa-layer-group"></i>
            <div>
                <strong>Агрегация данных</strong>
                <small>— формирование сводных файлов для ГИС ОМС</small>
            </div>
        </div>
        <div class="aggregation-actions" style="display: flex; gap: 16px; flex-wrap: wrap; width: 100%; margin-top: 12px;">
            <!-- GST Агрегация -->
            <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap; padding: 8px 12px; border-radius: 8px; border: 1px solid var(--border-color); flex: 1; min-width: 280px;">
                <span style="font-weight: 600; font-size: 13px;">GST (GSM→GST):</span>
                <select class="form-select" id="periodGstSelect" style="width: 130px; padding: 5px 10px; font-size: 13px;">
                    <option value="">Все периоды</option>
                    @foreach (var p in periods)
                    {
                        <option value="@p">@p</option>
                    }
                </select>
                <select class="form-select" id="moGstSelect" style="width: 110px; padding: 5px 10px; font-size: 13px;">
                    <option value="">Все МО</option>
                    @foreach (var mo in moList)
                    {
                        <option value="@mo">@mo</option>
                    }
                </select>
                <button class="btn-primary-custom" onclick="exportAggregated('GST')" style="padding: 5px 16px; font-size: 13px;">
                    <i class="fas fa-download"></i> Выгрузить
                </button>
            </div>
            <!-- GPT Агрегация -->
            <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap; padding: 8px 12px; border-radius: 8px; border: 1px solid var(--border-color); flex: 1; min-width: 280px;">
                <span style="font-weight: 600; font-size: 13px;">GPT (GPM→GPT):</span>
                <select class="form-select" id="periodGptSelect" style="width: 130px; padding: 5px 10px; font-size: 13px;">
                    <option value="">Все периоды</option>
                    @foreach (var p in periods)
                    {
                        <option value="@p">@p</option>
                    }
                </select>
                <select class="form-select" id="moGptSelect" style="width: 110px; padding: 5px 10px; font-size: 13px;">
                    <option value="">Все МО</option>
                    @foreach (var mo in moList)
                    {
                        <option value="@mo">@mo</option>
                    }
                </select>
                <button class="btn-primary-custom" onclick="exportAggregated('GPT')" style="padding: 5px 16px; font-size: 13px;">
                    <i class="fas fa-download"></i> Выгрузить
                </button>
            </div>
        </div>
    </div>
}

<!-- ========================================== -->
<!-- ФИЛЬТРЫ                                    -->
<!-- ========================================== -->
<div class="filter-bar">
    <div class="filter-row">
        <div class="filter-group" style="flex: 2;">
            <label>Поиск</label>
            <input type="text" placeholder="Имя файла, код МО..." id="searchInput" value="@search">
        </div>
        <div class="filter-group">
            <label>Тип файла</label>
            <select id="typeFilter">
                <option value="">Все типы</option>
                <option value="GST" selected="@(type == "GST")">GST</option>
                <option value="GPT" selected="@(type == "GPT")">GPT</option>
                <option value="GF" selected="@(type == "GF")">GF</option>
                <option value="GSM" selected="@(type == "GSM")">GSM</option>
                <option value="GPM" selected="@(type == "GPM")">GPM</option>
                <option value="DSPN" selected="@(type == "DSPN")">DSPN</option>
                <option value="PROF" selected="@(type == "PROF")">PROF</option>
                <option value="DF" selected="@(type == "DF")">DF</option>
            </select>
        </div>
        <div class="filter-group">
            <label>Код МО</label>
            <input type="text" placeholder="Например: 190006" id="hospitalFilter" value="@hospital">
        </div>
        <div class="filter-group">
            <label>Период</label>
            <select id="periodFilter">
                <option value="">Все периоды</option>
                @foreach (var p in periods)
                {
                    <option value="@p" selected="@(period == p)">@p</option>
                }
            </select>
        </div>
        <div class="filter-group">
            <label>Статус</label>
            <select id="statusFilter">
                <option value="">Все статусы</option>
                <option value="0" selected="@(status == "0")">📥 Загружен</option>
                <option value="1" selected="@(status == "1")">⏳ Проверяется</option>
                <option value="2" selected="@(status == "2")">✅ Готов</option>
                <option value="3" selected="@(status == "3")">❌ Ошибка</option>
            </select>
        </div>
        <div class="filter-actions">
            <button class="btn-primary-custom" id="applyFilters">
                <i class="fas fa-search"></i> Найти
            </button>
            <button class="btn-outline-custom" id="resetFilters">
                <i class="fas fa-undo"></i> Сбросить
            </button>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- ТАБЛИЦА ДОКУМЕНТОВ                         -->
<!-- ========================================== -->
<div class="table-wrapper">
    <div class="table-toolbar">
        <span class="count">Найдено записей: <strong>@totalCount</strong></span>
        <div>
            <button class="btn-outline-custom" style="padding:4px 12px;font-size:12px;" onclick="refreshStatusCounts()">
                <i class="fas fa-sync"></i> Обновить статусы
            </button>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table" id="documentsTable">
            <thead>
                <tr>
                    <th style="width:40px;">#</th>
                    <th>Дата загрузки</th>
                    <th>Имя файла</th>
                    <th>Тип</th>
                    <th>Код МО</th>
                    <th style="text-align:center;">Период</th>
                    <th style="text-align:center;">Записей</th>
                    <th style="text-align:center;min-width:120px;">Статус</th>
                    <th style="text-align:center;min-width:180px;">Действия</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int counter = 1 + (currentPage - 1) * 20;
                }
                @foreach (var doc in Model)
                {
                    <tr data-doc-id="@doc.Id">
                        <td>@counter</td>
                        <td>@doc.UploadDate.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>
                            <a href="@Url.Action("Details", "Export", new { id = doc.Id })" class="text-decoration-none">
                                @doc.FileName
                            </a>
                        </td>
                        <td>
                            <span class="badge-type @(doc.FileType == "GST" ? "gst" : 
                                doc.FileType == "GPT" ? "gpt" : 
                                doc.FileType == "GF" ? "gf" :
                                doc.FileType == "GSM" ? "gsm" : 
                                doc.FileType == "GPM" ? "gpm" :
                                doc.FileType == "DSPN" ? "dspn" : 
                                doc.FileType == "PROF" ? "prof" :
                                "df")" style="@(doc.FileType == "DSPN" ? "background:#e0e7ff; color:#3730a3;" : 
                                             doc.FileType == "PROF" ? "background:#fce4ec; color:#880e4f;" :
                                             doc.FileType == "DF" ? "background:#fef3c7; color:#92400e;" : "")">
                                @doc.FileType
                            </span>
                        </td>
                        <td>@(!string.IsNullOrEmpty(doc.HospitalCode) ? doc.HospitalCode : "-")</td>
                        <td style="text-align:center;">@(!string.IsNullOrEmpty(doc.Period) ? doc.Period : "-")</td>
                        <td style="text-align:center;">@doc.RecordsCount</td>
                        <td style="text-align:center;">
                            <span class="badge-status @doc.Status.GetCssClass()" id="statusBadge_@doc.Id">
                                @doc.Status.GetDisplayName()
                            </span>
                            @if (doc.Status == DocumentStatus.Error && !string.IsNullOrEmpty(doc.ValidationErrors))
                            {
                                <br/>
                                <span class="text-danger small" title="@doc.ValidationErrors">
                                    <i class="fas fa-exclamation-triangle"></i>
                                    @(doc.ValidationErrors.Length > 30 ? doc.ValidationErrors.Substring(0, 30) + "..." : doc.ValidationErrors)
                                </span>
                            }
                        </td>
                        <td style="text-align:center; white-space:nowrap;">
                            <!-- Проверить (только для Uploaded и Error) -->
                            @if (doc.Status == DocumentStatus.Uploaded || doc.Status == DocumentStatus.Error)
                            {
                                <button class="btn-sm-icon primary" onclick="checkDocument(@doc.Id)" title="Проверить">
                                    <i class="fas fa-check"></i>
                                </button>
                            }
                            else if (doc.Status == DocumentStatus.Checking)
                            {
                                <span class="text-muted"><i class="fas fa-spinner fa-spin"></i></span>
                            }
                            else if (doc.Status == DocumentStatus.Ready)
                            {
                                <span class="text-success"><i class="fas fa-check-circle"></i></span>
                            }

                            <!-- Скачать (только если готов) -->
                            @if (doc.Status == DocumentStatus.Ready || User.IsInRole("Admin"))
                            {
                                <a href="@Url.Action("Export" + doc.FileType, "Export", new { documentId = doc.Id })" 
                                   class="btn-sm-icon primary" title="Скачать ZIP">
                                    <i class="fas fa-download"></i>
                                </a>
                            }

                            <!-- Удалить -->
                            <button class="btn-sm-icon danger" onclick="deleteDocument(@doc.Id)" title="Удалить">
                                <i class="fas fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                    counter++;
                }
            </tbody>
        </table>
    </div>

    <!-- Пагинация -->
    <div class="pagination-bar">
        <div class="page-size">
            <span>Показано @Model.Count() из @totalCount записей</span>
        </div>
        <nav>
            <ul class="pagination">
                @if (currentPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("Index", new { 
                            page = currentPage - 1, 
                            search = search,
                            type = type,
                            hospital = hospital,
                            period = period,
                            status = status
                        })">«</a>
                    </li>
                }
                else
                {
                    <li class="page-item disabled"><span class="page-link">«</span></li>
                }

                @for (int i = 1; i <= Math.Min(totalPages, 7); i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { 
                            page = i, 
                            search = search,
                            type = type,
                            hospital = hospital,
                            period = period,
                            status = status
                        })">@i</a>
                    </li>
                }

                @if (currentPage < totalPages)
                {
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("Index", new { 
                            page = currentPage + 1, 
                            search = search,
                            type = type,
                            hospital = hospital,
                            period = period,
                            status = status
                        })">»</a>
                    </li>
                }
                else
                {
                    <li class="page-item disabled"><span class="page-link">»</span></li>
                }
            </ul>
        </nav>
        <span style="font-size:13px; color:var(--text-muted);">
            Страница @currentPage из @totalPages
        </span>
    </div>
</div>

<!-- Скрытый токен для AJAX -->
@Html.AntiForgeryToken()

@section Scripts {
    <script>
        $(document).ready(function() {

            // ==========================================
            // АГРЕГАЦИЯ (для Admin)
            // ==========================================
            window.exportAggregated = function(type) {
                let period, moCode, url;

                switch(type) {
                    case 'GST':
                        period = $('#periodGstSelect').val();
                        moCode = $('#moGstSelect').val();
                        url = '@Url.Action("ExportAggregatedGst", "Export")';
                        break;
                    case 'GPT':
                        period = $('#periodGptSelect').val();
                        moCode = $('#moGptSelect').val();
                        url = '@Url.Action("ExportAggregatedGpt", "Export")';
                        break;
                    default:
                        return;
                }

                let params = [];
                if (period) params.push(`period=${encodeURIComponent(period)}`);
                if (moCode) params.push(`moCode=${encodeURIComponent(moCode)}`);

                const fullUrl = params.length > 0 ? `${url}?${params.join('&')}` : url;
                window.location.href = fullUrl;
            };

            // ==========================================
            // ФИЛЬТРЫ
            // ==========================================
            $('#applyFilters').on('click', function() {
                const search = $('#searchInput').val();
                const type = $('#typeFilter').val();
                const hospital = $('#hospitalFilter').val();
                const period = $('#periodFilter').val();
                const status = $('#statusFilter').val();

                let url = '@Url.Action("Index")';
                let params = [];
                if (search) params.push(`search=${encodeURIComponent(search)}`);
                if (type) params.push(`type=${encodeURIComponent(type)}`);
                if (hospital) params.push(`hospital=${encodeURIComponent(hospital)}`);
                if (period) params.push(`period=${encodeURIComponent(period)}`);
                if (status) params.push(`status=${encodeURIComponent(status)}`);

                if (params.length > 0) {
                    window.location.href = url + '?' + params.join('&');
                } else {
                    window.location.href = url;
                }
            });

            $('#resetFilters').on('click', function() {
                window.location.href = '@Url.Action("Index")';
            });

            $('.filter-group input, .filter-group select').on('keypress', function(e) {
                if (e.key === 'Enter') {
                    $('#applyFilters').click();
                }
            });

            // ==========================================
            // ПРОВЕРКА ДОКУМЕНТА
            // ==========================================
            window.checkDocument = function(id) {
                const btn = $(`button[onclick="checkDocument(${id})"]`);
                btn.html('<i class="fas fa-spinner fa-spin"></i>');
                btn.prop('disabled', true);

                const token = $('input[name="__RequestVerificationToken"]').val();

                $.ajax({
                    url: '@Url.Action("CheckDocument", "Export")',
                    type: 'POST',
                    data: { documentId: id },
                    headers: {
                        'RequestVerificationToken': token
                    },
                    success: function(response) {
                        if (response.success) {
                            alert('✅ ' + response.message);
                            location.reload();
                        } else {
                            const errors = response.errors ? response.errors.join('\n') : response.message;
                            alert('❌ Ошибки проверки:\n' + errors);
                            location.reload();
                        }
                    },
                    error: function(xhr) {
                        alert('❌ Ошибка: ' + (xhr.responseJSON?.message || 'Неизвестная ошибка'));
                        location.reload();
                    }
                });
            };

            // ==========================================
            // МАССОВАЯ ПРОВЕРКА
            // ==========================================
            window.checkAllDocuments = function() {
                if (!confirm('Запустить проверку всех документов со статусом "Загружен" или "Ошибка"?')) {
                    return;
                }

                const btn = $('.btn-success-custom');
                btn.html('<i class="fas fa-spinner fa-spin"></i> Проверка...');
                btn.prop('disabled', true);

                const token = $('input[name="__RequestVerificationToken"]').val();

                $.ajax({
                    url: '@Url.Action("CheckAllDocuments", "Export")',
                    type: 'POST',
                    headers: {
                        'RequestVerificationToken': token
                    },
                    success: function(response) {
                        alert(`✅ Проверка завершена!\nПроверено: ${response.total}\nУспешно: ${response.checkedCount}\nОшибок: ${response.errorCount}`);
                        location.reload();
                    },
                    error: function() {
                        alert('❌ Ошибка при массовой проверке');
                        location.reload();
                    }
                });
            };

            // ==========================================
            // УДАЛЕНИЕ ДОКУМЕНТА
            // ==========================================
            window.deleteDocument = function(id) {
                if (!confirm('Удалить документ #' + id + '?')) {
                    return;
                }

                const token = $('input[name="__RequestVerificationToken"]').val();

                $.ajax({
                    url: '@Url.Action("Delete", "Export")',
                    type: 'POST',
                    data: { id: id },
                    headers: {
                        'RequestVerificationToken': token
                    },
                    success: function(response) {
                        if (response.success) {
                            location.reload();
                        } else {
                            alert(response.message || 'Ошибка при удалении');
                        }
                    },
                    error: function() {
                        alert('Ошибка при удалении');
                    }
                });
            };

            // ==========================================
            // ОБНОВЛЕНИЕ СТАТУСОВ
            // ==========================================
            window.refreshStatusCounts = function() {
                $.get('@Url.Action("GetStatusCounts", "Export")', function(data) {
                    $('#statusUploaded').text(data.uploaded || 0);
                    $('#statusChecking').text(data.checking || 0);
                    $('#statusReady').text(data.ready || 0);
                    $('#statusError').text(data.error || 0);
                });
            };

            // Обновляем статусы каждые 10 секунд
            setInterval(refreshStatusCounts, 10000);

        });
    </script>
}