@{
    ViewData["Title"] = "Доступ запрещен";
    Layout = null;
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RegistrDN</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
        body {
            background: #f0f2f6;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            margin: 0;
            padding: 20px;
        }
        .denied-container {
            max-width: 500px;
            width: 100%;
            background: #fff;
            border-radius: 12px;
            padding: 40px;
            text-align: center;
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
            border: 1px solid #e2e8f0;
        }
        .denied-container i {
            font-size: 64px;
            color: #e53e3e;
            margin-bottom: 16px;
        }
        .denied-container h1 {
            font-weight: 700;
            color: #1a202c;
        }
        .denied-container p {
            color: #4a5568;
        }
        .denied-container .btn {
            margin-top: 20px;
        }
    </style>
</head>
<body>
    <div class="denied-container">
        <i class="fas fa-ban"></i>
        <h1>Доступ запрещен</h1>
        <p>У вас нет прав для доступа к этой странице.</p>
        <a href="/" class="btn-primary-custom" style="display:inline-block; text-decoration:none;">
            <i class="fas fa-home"></i> На главную
        </a>
    </div>
</body>
</html>